def test_ensure_lock_restored_on_error():
    """`ensure_lock` restores the previous lock state even when the wrapped
    block raises"""
    from pytest import raises

    from tqdm.auto import tqdm as tqdm_auto
    from tqdm.contrib.concurrent import ensure_lock

    class T(tqdm_auto):
        pass

    # case 1: no pre-existing lock -> attribute removed afterwards
    assert '_lock' not in T.__dict__
    with raises(RuntimeError):
        with ensure_lock(T):
            assert '_lock' in T.__dict__
            raise RuntimeError("boom")
    assert '_lock' not in T.__dict__, "ensure_lock leaked the lock on error"

    # case 2: pre-existing lock -> restored afterwards
    sentinel = T.get_lock()
    with raises(RuntimeError):
        with ensure_lock(T):
            raise RuntimeError("boom")
    assert T.__dict__['_lock'] is sentinel
    del T._lock
EOF
