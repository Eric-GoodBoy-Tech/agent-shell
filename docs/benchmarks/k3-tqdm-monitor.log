@restore_sys
def test_main_log_invalid(capsysbinary):
    """Test CLI --log validation errors exit with code 2"""
    sys.stdin = [b'1\n']
    with raises(SystemExit) as excinfo:
        main(sys.stderr, ['--log', 'FOO'])
    assert excinfo.value.code == 2
    out, err = capsysbinary.readouterr()
    assert b"invalid --log level" in err and out == b''

    with raises(SystemExit) as excinfo:
        main(sys.stderr, ['--log'])
    assert excinfo.value.code == 2
    out, err = capsysbinary.readouterr()
    assert b"--log missing value" in err and out == b''


@mark.slow
@mark.skipif(IS_WIN, reason="POSIX-only: relies on SIGPIPE/EPIPE semantics")
def test_broken_pipe():
    """Test CLI exits cleanly when the output pipe is closed early"""
    writer = subprocess.Popen(  # nosec
        [sys.executable, '-c',
         'import sys\nfor i in range(100000):\n sys.stdout.write("1\\n")'],
        stdout=subprocess.PIPE)
    proc = subprocess.Popen(  # nosec
        [sys.executable, '-m', 'tqdm'],
        stdin=writer.stdout, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    writer.stdout.close()
    proc.stdout.close()  # downstream closes the pipe immediately
    err = proc.stderr.read()
    assert proc.wait() == 0
    assert b'Traceback' not in err
    writer.wait()
