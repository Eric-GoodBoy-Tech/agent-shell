model = keras.models.Sequential([keras.layers.Input((1,)), keras.layers.Dense(1)])
model.compile("adam", "mse")
x = np.random.rand(50, 1).astype("float32")
cb = TqdmCallback(epochs=2, data_size=len(x), batch_size=10, verbose=1, desc="training")
# instrument: does Keras 3 dispatch the dynamically-assigned on_batch_end?
hits = {"batch": 0}
orig_cb = cb.on_batch_end
def spy(*a, **k):
    hits["batch"] += 1
    return orig_cb(*a, **k)
cb.on_batch_end = spy
model.fit(x, x, epochs=2, batch_size=10, verbose=0, callbacks=[cb])
print("on_batch_end dispatched:", hits["batch"], "times; batch bar n =", cb.batch_bar.n)
EOF
