# Agent Shell Configuration
# Copy this file to .env and fill in your values.
# Note: agent.zsh reads this file line-by-line; only full-line comments are
# supported — do not put trailing "# ..." comments after a value.
#
# Layering (later wins): defaults -> .env -> shell environment -> ~/.agshrc -> .agshrc

# ── Required: API access ────────────────────────────────────────────────────
# Any chat-completions compatible endpoint. "/v1/chat/completions" is appended, so give
# the base URL without that suffix and without a trailing slash.
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=

# ── Optional: reasoning / streaming (defaults owned by the TS layer) ────────
# Reasoning depth, e.g. "high" or "max".
AGENT_REASONING_EFFORT=high
# Seconds to wait for the first token before aborting a streaming call (0=off).
AGENT_API_TTFT_TIMEOUT=120

# ── Optional: execution settings (defaults owned by agent.zsh Layer 2) ──────
# Seconds before a displayed command is auto-executed.
AGENT_EXEC_DELAY=2
# Command output longer than this many characters is truncated.
AGENT_OUTPUT_MAX_LENGTH=10000
# Timeout for a captured command (seconds, 0=disabled).
AGENT_EXEC_TIMEOUT=0
# Debug logging, read by "agent debug tail" / "agent debug cat".
AGENT_DEBUG=false
# Shell poll interval in seconds.
AGENT_POLL_INTERVAL=0.05
# Node tree root. A relative path is resolved against the current directory.
AGENT_NODES_PATH=.agsh/nodes
