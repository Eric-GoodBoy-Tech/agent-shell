# Agent Shell Configuration
# Copy this file to .env and fill in your values

# Required: API Key for the LLM provider
AGENT_API_KEY=

# Optional: LLM Configuration
AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AGENT_MODEL=qwen-max

# Optional: Execution settings
AGENT_EXEC_DELAY=2
AGENT_OUTPUT_MAX_LENGTH=10000

# Optional: Agent execution timeout for captured commands (seconds, 0=disabled)
AGENT_EXEC_TIMEOUT=120
AGENT_DEBUG=false
